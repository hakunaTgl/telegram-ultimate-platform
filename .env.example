# 🤖 Telegram Bot Token - Get this from @BotFather on Telegram
# Message https://t.me/BotFather to create a bot and receive your token.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# 🐘 PostgreSQL Database URL - Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Ensure you have created the database first (e.g., 'telegram_platform')
DATABASE_URL=postgresql://postgres:password@localhost:5432/telegram_platform

# 🧠 OpenAI API Key - Get this from https://platform.openai.com/api-keys
# Required for AI-powered intelligence and intent inference.
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
